# Copy to .env and fill in. Never commit the real .env file.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=

# Your domain(s), comma separated
DJANGO_ALLOWED_HOSTS=service.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://service.example.com

# PostgreSQL connection
DATABASE_URL=postgres://flowline:CHANGE_ME@db:5432/flowline
POSTGRES_PASSWORD=CHANGE_ME
# Set to true when the database is on another server (managed Postgres)
DATABASE_SSL_REQUIRE=false

# Leave DJANGO_DEBUG=false in production. true = local development only.
DJANGO_DEBUG=false
# HTTPS redirect, secure cookies and HSTS. Keep true in production.
DJANGO_HTTPS=true
# Set to true when nginx / a load balancer terminates HTTPS in front of the app
DJANGO_BEHIND_PROXY=true
# Number of trusted proxies in front of the app (used for login lockout by IP)
TRUSTED_PROXY_COUNT=1

# Admin area path. Pick something unguessable, e.g. manage-4k9q2/
DJANGO_ADMIN_URL=manage-change-me/

# Sign-in lockout: failures before lockout and lockout length in hours
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=0.5
# Signed-in session length in hours
SESSION_HOURS=10

COMPANY_NAME=Flowline Water Technologies
TIME_ZONE=Asia/Manila
